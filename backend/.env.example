# Supabase — use service role key on the server (never expose in the browser)
# Project root URL only — do NOT append /rest/v1
SUPABASE_URL=https://urfpiauvuusibgzeyjjf.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Student
STUDENT_ID=guhan

# LLM: Claude (Anthropic) is primary.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional automatic fallback — only used if Claude is rate-limited,
# overloaded, out of credits, or unreachable. Leave blank to disable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Generation defaults
QUESTIONS_PER_TOPIC=5
TARGET_QUESTIONS_PER_SUBJECT=10
PROGRESS_LOOKBACK_DAYS=7
PROGRESS_EWMA_DECAY=0.7
DEDUP_LOOKBACK_DAYS=21
ADAPTIVE_QUESTION_COUNTS=true
LLM_RETRY_ON_DUPLICATES=1
PROMPT_VERSION=iep-v2-adaptive

# FastAPI
API_HOST=0.0.0.0
API_PORT=8001
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://prakashohm.github.io
